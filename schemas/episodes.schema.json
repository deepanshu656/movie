{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpisodesSchema",
  "description": "Schema for series episode explorer list",
  "type": "object",
  "required": ["seriesTitle", "currentSeason", "totalSeasons", "episodes"],
  "properties": {
    "seriesTitle": { "type": "string", "default": "Lucifer" },
    "currentSeason": { "type": "integer", "default": 1 },
    "totalSeasons": { "type": "integer", "default": 6 },
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["episodeNumber", "title", "duration", "synopsis"],
        "properties": {
          "episodeNumber": { "type": "integer" },
          "title": { "type": "string" },
          "duration": { "type": "string" },
          "synopsis": { "type": "string" },
          "thumbnailUrl": { "type": "string" },
          "progress": { "type": "number", "default": 0 }
        }
      }
    }
  }
}
