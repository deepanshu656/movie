{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchCatalogSchema",
  "description": "Schema for movie, anime, and cartoon search catalog items allowing effortless future additions",
  "type": "object",
  "required": ["searchQuery", "totalMatches", "items"],
  "properties": {
    "searchQuery": { "type": "string", "default": "shinchan" },
    "totalMatches": { "type": "integer", "default": 33 },
    "subtitle": { "type": "string", "default": "33 matching titles. Explore by category, network, year, or a title you love." },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "year", "type", "category", "network", "posterUrl"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "default": 7.0
          },
          "year": { "type": "integer" },
          "type": { "type": "string", "enum": ["Movie", "Series"] },
          "category": { "type": "string", "default": "Cartoon" },
          "network": { "type": "string", "default": "TV Asahi" },
          "duration": { "type": "string", "default": "1j 35m" },
          "posterUrl": { "type": "string" },
          "synopsis": { "type": "string" },
          "trailerUrl": { "type": "string" },
          "isAddedToWatchlist": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
